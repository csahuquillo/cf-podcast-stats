# ─── cf-podcast-stats configuration ───
# Copy to `.env` (same folder as weekly_report.py) and fill in.

# Source: cloudfront (legacy) or r2 (Cloudflare R2 Data Access Logs).
CFPS_SOURCE=cloudfront

# Legacy CloudFront access-log location (S3). Required only with CFPS_SOURCE=cloudfront.
CFPS_LOG_BUCKET=my-podcast-cf-logs
CFPS_LOG_PREFIX=                 # optional key prefix inside the bucket, e.g. "cf-logs/"

# Cloudflare R2 Data Access Logs. Required only with CFPS_SOURCE=r2.
# The token needs Account Analytics Read on the account. Store the value only in the
# server's secret store / protected environment; never commit it or put it in this file.
CFPS_CLOUDFLARE_API_TOKEN=
CFPS_CLOUDFLARE_ACCOUNT_TAG=
CFPS_R2_BUCKET=sahuquillo-media
CFPS_R2_DATASET=logs.r2
CFPS_R2_PAGE_SIZE=1000
CFPS_R2_MAX_ROWS=100000

# How the episode id is captured from the request URI. Default matches ".../<id>.mp3".
# If your files are like /episodes/110-my-slug.mp3 and you want to group by number, use:
#   CFPS_EPISODE_REGEX=/episodes/(\d+)-
CFPS_EPISODE_REGEX=/([^/]+?)\.mp3

CFPS_WINDOW_DAYS=7               # rolling window for each report
CFPS_BRAND=My Podcast
CFPS_CF_HOST=podcast.example.com # only shown in the email header
CFPS_FEED_URL=                   # optional RSS URL to resolve nice episode titles
CFPS_GEOIP=1                     # 1 = geolocate IPs via ip-api.com (free); 0 = skip country stats
# IPs to ignore (comma-separated), e.g. your web server if a WordPress podcast plugin
# proxies the MP3 through it — otherwise every such listen geolocates to the server's country.
CFPS_EXCLUDE_IPS=
CFPS_STATE_DIR=                  # where cache/state/logs live (default: ./state next to the script)

# ─── email ───
CFPS_EMAIL_TO=you@example.com
CFPS_EMAIL_FROM=you@example.com
CFPS_EMAIL_METHOD=smtp           # smtp | gmail_api | none

# if CFPS_EMAIL_METHOD=smtp
CFPS_SMTP_HOST=smtp.gmail.com
CFPS_SMTP_PORT=587
CFPS_SMTP_TLS=1
CFPS_SMTP_USER=you@example.com
CFPS_SMTP_PASS=your-app-password

# if CFPS_EMAIL_METHOD=gmail_api  (a Google OAuth token json with gmail.send scope)
CFPS_GOOGLE_TOKEN=/path/to/google_token.json
